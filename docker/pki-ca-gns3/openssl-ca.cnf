# OpenSSL CA configuration for the eval1 lab PKI.
# The signing key is always passed on the command line as a PKCS#11 URI
# (see /usr/local/sbin/pki-comun.sh); no key file exists on disk.

[ ca ]
default_ca = ca_emisora

[ ca_raiz ]
dir              = /srv/ca/raiz
database         = $dir/index.txt
serial           = $dir/serial
crlnumber        = $dir/crlnumber
new_certs_dir    = $dir/emitidos
certificate      = $dir/raiz.pem
default_md       = sha256
default_days     = 1825
default_crl_days = 365
policy           = politica_ca
unique_subject   = no
copy_extensions  = none
email_in_dn      = no

[ ca_emisora ]
dir              = /srv/ca/emisora
database         = $dir/index.txt
serial           = $dir/serial
crlnumber        = $dir/crlnumber
new_certs_dir    = $dir/emitidos
certificate      = $dir/emisora.pem
default_md       = sha256
default_days     = 365
default_crl_days = 7
policy           = politica_final
unique_subject   = no
copy_extensions  = none
email_in_dn      = no

# End entities: the subject is forced by pki-emitir (-subj), never taken from the CSR.
[ politica_final ]
organizationName = optional
commonName       = supplied

[ politica_ca ]
countryName            = optional
organizationName       = supplied
organizationalUnitName = optional
commonName             = supplied

[ req ]
distinguished_name = req_dn
string_mask        = utf8only

[ req_dn ]

# Root CA: RSA-3072, 10 years, self-signed.
[ v3_raiz ]
basicConstraints     = critical, CA:true
keyUsage             = critical, keyCertSign, cRLSign
subjectKeyIdentifier = hash

# Issuing CA: RSA-3072, 5 years, signed by the root; issues end entities only.
[ v3_emisora ]
basicConstraints       = critical, CA:true, pathlen:0
keyUsage               = critical, keyCertSign, cRLSign
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always
crlDistributionPoints  = URI:http://10.99.0.10/crl/raiz.crl

[ crl_ext ]
authorityKeyIdentifier = keyid:always

# --- End-entity profiles of the issuing CA (pki-emitir) ---------------------
# PKI_SAN is set by pki-emitir; the SAN never comes from the CSR.
# 1.3.6.1.5.5.8.2.2 = id-kp-ipsecIKE.

[ v3_servidor ]
basicConstraints       = critical, CA:false
keyUsage               = critical, digitalSignature
extendedKeyUsage       = serverAuth
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid
subjectAltName         = $ENV::PKI_SAN
crlDistributionPoints  = URI:http://10.99.0.10/crl/emisora.crl
authorityInfoAccess    = OCSP;URI:http://10.99.0.10:2560, caIssuers;URI:http://10.99.0.10/ca/emisora.pem

[ v3_equipo ]
basicConstraints       = critical, CA:false
keyUsage               = critical, digitalSignature
extendedKeyUsage       = serverAuth, clientAuth, 1.3.6.1.5.5.8.2.2
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid
subjectAltName         = $ENV::PKI_SAN
crlDistributionPoints  = URI:http://10.99.0.10/crl/emisora.crl
authorityInfoAccess    = OCSP;URI:http://10.99.0.10:2560, caIssuers;URI:http://10.99.0.10/ca/emisora.pem

[ v3_usuario ]
basicConstraints       = critical, CA:false
keyUsage               = critical, digitalSignature
extendedKeyUsage       = clientAuth, 1.3.6.1.5.5.8.2.2
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid
subjectAltName         = $ENV::PKI_SAN
crlDistributionPoints  = URI:http://10.99.0.10/crl/emisora.crl
authorityInfoAccess    = OCSP;URI:http://10.99.0.10:2560, caIssuers;URI:http://10.99.0.10/ca/emisora.pem

[ v3_socio ]
basicConstraints       = critical, CA:false
keyUsage               = critical, digitalSignature, keyEncipherment
extendedKeyUsage       = serverAuth, clientAuth, emailProtection
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid
subjectAltName         = $ENV::PKI_SAN
crlDistributionPoints  = URI:http://10.99.0.10/crl/emisora.crl
authorityInfoAccess    = OCSP;URI:http://10.99.0.10:2560, caIssuers;URI:http://10.99.0.10/ca/emisora.pem

# OCSP responder certificate (key in the issuing token).
[ v3_ocsp ]
basicConstraints       = critical, CA:false
keyUsage               = critical, digitalSignature
extendedKeyUsage       = critical, OCSPSigning
noCheck                = ignored
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid
